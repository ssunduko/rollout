# Template for .env — copy it to .env and fill in values:
#   cp .env.example .env
# .env is gitignored; this file is committed, so keep it free of secrets.
# Every key the pipeline reads is listed here. Read by pipeline/env.mjs; an
# exported shell variable always wins over the file.

# ---- brand (pipeline/brand.mjs) ----

# Folder holding the brand sidecar (brand.json) and the files it names.
# Relative to the repo root.
BRAND_DIR=brand/example

# Optional overrides of brand.json values. Leave empty to use brand.json.
BRAND_NAME=
BRAND_WEBSITE=
BRAND_WEBSITE_LABEL=
BRAND_PHONE=
BRAND_EMAIL=
# Any colour token from brand.json: BRAND_COLOR_<TOKEN>, token upper-cased,
# e.g. BRAND_COLOR_PRIMARY=#0055ff, BRAND_COLOR_HEROTINT=#cfe4ff
# BRAND_COLOR_PRIMARY=

# ---- copy defaults (pipeline/brief.mjs) ----
# Used when a feature's brief does not set its own.

# Pill label in the hero band.
TOPIC_PILL=#product update
# Closing call-to-action band (last PDF page and the web page).
CTA_TITLE=Transform your customer conversations today
CTA_SUBTITLE=Join thousands of growing teams already using it.
CTA_BUTTON=Start a free 14-day trial
CTA_URL=https://www.acme.example/signup
# Header button label on the web page, for brands without a "web" block.
WEB_HERO_BUTTON=Try for free

# ---- folders (pipeline/env.mjs) ----
# Relative to the repo root.
INPUT_DIR=input
LIBRARY_DIR=library
OUTPUT_DIR=output

# ---- rendering ----

# Chrome or Edge. Auto-detected when empty.
CHROME_PATH=
# ffmpeg for GIFs. Default: ffmpeg on PATH.
FFMPEG=
# PDF page size: A4 | Letter
PAGE_SIZE=A4
# Pixel density of PNG stills (2 = crisp in print).
STILL_SCALE=2
# GIF frame rate and scale (1 = the scene's CSS size).
GIF_FPS=12
GIF_SCALE=1
# Date locale for the optional date line.
LOCALE=en-US

# ---- capture: logging into the application (pipeline/capture.mjs) ----

# Target used when neither the scene nor input/<slug>/feature.json names one.
# A file in targets/ (without .json).
CAPTURE_TARGET=demo-app
# Run the capture browser headless (true) or visible (false, for debugging).
CAPTURE_HEADLESS=true
# Device pixel ratio of captures: 2 gives print-quality stills.
CAPTURE_SCALE=2
# Width of captured GIFs in pixels (clips narrower than this keep their size).
GIF_WIDTH=800
# Waits longer than this (page loads) are fast-forwarded to it in the GIF.
CAPTURE_MAX_WAIT_MS=700
# ffprobe, if not next to ffmpeg / on PATH.
FFPROBE=

# Credentials and URLs of capture targets, referenced from targets/*.json as
# env:NAME. Never put real credentials in a committed file.
# The example application (npm run demo-app):
DEMO_APP_URL=http://localhost:4173
DEMO_APP_PORT=4173
DEMO_APP_USERNAME=demo@acme.example
DEMO_APP_PASSWORD=demo-password

# ---- web page visuals (pipeline/webmedia.mjs) ----
# Each section's visual on the web page: a framed cut of the capture at this
# size (the site's feature pages use 1180x676), at this frame rate.
WEB_GIF_WIDTH=1180
WEB_GIF_HEIGHT=676
WEB_GIF_FPS=20
# The frame drawn into the image: border colour and corner radius (px).
WEB_FRAME_BORDER=#e3e7ec
WEB_FRAME_RADIUS=20

# ---- local preview (pipeline/serve.mjs) ----
# Port of `rollout.mjs serve <slug>`, which shows the built web page in a
# browser. QA picks its own free port.
WEB_PORT=4400

# ---- quality gate (pipeline/qa.mjs) ----
# Comma-separated words that must not appear in a built rollout (another
# brand's name, an internal codename). QA fails if any does.
QA_FORBIDDEN_TERMS=
