# Template for .env — copy it to .env and fill in values:
#   cp .env.example .env
# .env is gitignored; this file is committed, so keep it free of secrets.
# Every key the pipeline reads is listed here. Read by pipeline/env.mjs; an
# exported shell variable always wins over the file.

# ---- brand (pipeline/brand.mjs) ----

# Folder holding the brand sidecar (brand.json) and the files it names.
# Relative to the repo root.
BRAND_DIR=brand/example

# Optional overrides of brand.json values. Leave empty to use brand.json.
BRAND_NAME=
BRAND_WEBSITE=
BRAND_WEBSITE_LABEL=
BRAND_PHONE=
BRAND_EMAIL=
# Any colour token from brand.json: BRAND_COLOR_<TOKEN>, token upper-cased,
# e.g. BRAND_COLOR_PRIMARY=#0055ff, BRAND_COLOR_HEROTINT=#cfe4ff
# BRAND_COLOR_PRIMARY=

# ---- copy defaults (pipeline/brief.mjs) ----
# Used when a feature's brief does not set its own.

# Pill label in the hero band.
TOPIC_PILL=#product update
# Closing call-to-action band (last PDF page and the web page).
CTA_TITLE=Transform your customer conversations today
CTA_SUBTITLE=Join thousands of growing teams already using it.
CTA_BUTTON=Start a free 14-day trial
CTA_URL=https://www.acme.example/signup
# Header button label on the web page, for brands without a "web" block.
WEB_HERO_BUTTON=Try for free

# ---- folders (pipeline/env.mjs) ----
# Relative to the repo root.
INPUT_DIR=input
LIBRARY_DIR=library
OUTPUT_DIR=output

# ---- rendering ----

# Chrome or Edge. Auto-detected when empty.
CHROME_PATH=
# ffmpeg for GIFs. Default: ffmpeg on PATH.
FFMPEG=
# PDF page size: A4 | Letter
PAGE_SIZE=A4
# Pixel density of PNG stills (2 = crisp in print).
STILL_SCALE=2
# GIF frame rate and scale (1 = the scene's CSS size).
GIF_FPS=12
GIF_SCALE=1

# ---- capture: logging into the application (pipeline/capture.mjs) ----

# Target used when neither the scene nor input/<slug>/feature.json names one.
# A file in targets/ (without .json).
CAPTURE_TARGET=demo-app
# Run the capture browser headless (true) or visible (false, for debugging).
CAPTURE_HEADLESS=true
# Device pixel ratio of captures: 2 gives print-quality stills.
CAPTURE_SCALE=2
# Width of captured GIFs in pixels (clips narrower than this keep their size).
GIF_WIDTH=800
# Waits longer than this (page loads) are fast-forwarded to it in the GIF.
CAPTURE_MAX_WAIT_MS=700
# ffprobe, if not next to ffmpeg / on PATH.
FFPROBE=
# Keep the raw capture frames and the frame list next to the GIF for
# debugging (any value). Empty: they are deleted after encoding.
CAPTURE_DEBUG=

# Credentials and URLs of capture targets, referenced from targets/*.json as
# env:NAME. Never put real credentials in a committed file.
# The example application (npm run demo-app):
DEMO_APP_URL=http://localhost:4173
DEMO_APP_PORT=4173
DEMO_APP_USERNAME=demo@acme.example
DEMO_APP_PASSWORD=demo-password

# ---- web page visuals (pipeline/webmedia.mjs) ----
# Each section's visual on the web page: a framed cut of the capture at this
# size (the site's feature pages use 1180x676), at this frame rate.
WEB_GIF_WIDTH=1180
WEB_GIF_HEIGHT=676
WEB_GIF_FPS=20
# The frame drawn into the image: border colour and corner radius (px).
WEB_FRAME_BORDER=#e3e7ec
WEB_FRAME_RADIUS=20

# ---- help article (pipeline/help.mjs, pipeline/helpcenter.mjs, docs/help.md) ----
# The help center articles are published to: an adapter in
# pipeline/helpcenter/ (intercom). Empty: the brand's help.provider.
HELP_CENTER=
# Access token with read and write access to help articles. Secret.
HELP_CENTER_TOKEN=
# API base URL. Empty: the adapter's default (https://api.intercom.io; EU
# https://api.eu.intercom.io, AU https://api.au.intercom.io).
HELP_CENTER_API_URL=
# API version header. Empty: the adapter's default (2.14).
HELP_CENTER_API_VERSION=
# Where help-publish uploads new or changed article images so the help center
# can copy them: an adapter in pipeline/imagestore/ (s3). Empty: no store —
# HELP_IMAGE_BASE_URL hosting, else placeholders (draft only). docs/help.md.
HELP_IMAGE_STORE=
# The store's bucket.
HELP_IMAGE_BUCKET=
# The bucket's region. Empty: AWS_REGION, the profile's region in
# ~/.aws/config, else us-east-1.
HELP_IMAGE_REGION=
# Key prefix: objects are <prefix>/<slug>/<scene>.<hash>.<ext>. Empty: help.
HELP_IMAGE_PREFIX=
# Endpoint of an S3-compatible store (path-style). Empty: S3 itself.
HELP_IMAGE_ENDPOINT=
# Seconds the presigned image links stay valid (at most 604800). Empty: 86400.
HELP_IMAGE_URL_TTL=
# Public base URL of the images. With a store: the URL of its prefix (public
# bucket or CDN), linked as <base>/<slug>/<object> instead of presigned links.
# Without one: where you host output/<slug>/help/images/, as
# <base>/<slug>/<file>. Empty with neither: images are placeholders and the
# article can only be sent as a draft.
HELP_IMAGE_BASE_URL=
# The image store's credentials. Secret. Empty: the keys of profile
# AWS_PROFILE (empty: default) in ~/.aws/credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
# Region when HELP_IMAGE_REGION is empty.
AWS_REGION=
# The frame drawn into each article image (help centers keep no CSS border):
# white padding (px), corner radius (px) and border colour. Empty: 24, 12,
# WEB_FRAME_BORDER.
HELP_FRAME_PAD=
HELP_FRAME_RADIUS=
HELP_FRAME_BORDER=
# Help-center id of the teammate new articles are credited to (required to
# create an article). rollout.mjs help-center lists them.
HELP_AUTHOR_ID=
# Fallback collection for new articles. The help writer picks each new
# article's collection from context (help.json publish.parentId); this applies
# only when it finds none that fits. Empty: not filed. help-center lists them.
HELP_COLLECTION_ID=

# ---- website: the feature page in the site builder (pipeline/website.mjs, docs/website.md) ----
# The site builder feature pages are published to: an adapter in
# pipeline/website/ (webflow). Empty: the brand's web.provider.
WEBSITE=
# Data API base URL. Empty: https://api.webflow.com/v2
WEBFLOW_API_URL=
# Site API token (Site settings > Apps & integrations > API access) with
# sites:read, pages:read, components:read, assets:read + assets:write and
# cms:read.
# Secret. Building pages and components goes through the Webflow MCP server,
# which signs in on its own.
WEBFLOW_API_TOKEN=
# The site feature pages go to. rollout.mjs site lists the sites the token
# can reach.
WEBFLOW_SITE_ID=
# Page folder new feature pages are created in. rollout.mjs site lists the
# folders. Empty: the site root, unless site.json names one.
WEBFLOW_PAGE_FOLDER_ID=
# CMS collection the site keeps its feature pages in (one item per feature,
# shown by the collection's template). Set: the feature page is planned as an
# item there. Empty: a standalone page built from components. The token then
# also needs cms:read; the item is written through the Webflow MCP server.
WEBFLOW_FEATURES_COLLECTION_ID=
# Component group that components created for feature pages join. Empty: Rollout
WEBFLOW_COMPONENT_GROUP=

# ---- local preview (pipeline/serve.mjs) ----
# Port of `rollout.mjs serve <slug>`, which shows the built web page in a
# browser. QA picks its own free port.
WEB_PORT=4400

# ---- quality gate (pipeline/qa.mjs) ----
# Comma-separated words that must not appear in a built rollout (another
# brand's name, an internal codename). QA fails if any does.
QA_FORBIDDEN_TERMS=
