            "headline": "name",
            "description": "subtitle",
            "image": "main-image",
            "customer": "company-name",
            "industry": "industry",
            "location": "headquarters"
          }
        },
        "authors": {
          "type": "profile",
          "collectionId": "",
          "path": "/author/{slug}",
