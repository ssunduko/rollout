          "path": "/podcasts/{slug}",
          "section": {
            "name": "Podcast",
            "path": "/podcasts"
          },
          "series": {
            "name": "The Acme Cloud Podcast",
            "url": "https://www.acme.example/podcasts"
          },
          "fields": {
            "name": "name",
            "description": "meta-description",
            "image": "main-image",
            "audioUrl": "mp3-link",
            "episodeNumber": "episode-number"
          }
        },
        "webinars": {
          "type": "event",
          "collectionId": "",
          "path": "/webinars/{slug}",
          "section": {
            "name": "Webinars",
            "path": "/webinars"
          },
          "free": true,
          "fields": {
            "name": "title",
            "description": "meta-description",
            "image": "cover-image",
            "startDate": "date",
            "registrationUrl": "registration-link",
            "recordingUrl": "video-link"
          }
        },
        "stories": {
          "type": "story",
          "collectionId": "",
          "path": "/stories/{slug}",
          "section": {
            "name": "Customer stories",
