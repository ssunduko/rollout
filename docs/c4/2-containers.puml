@startuml containers
' C4 level 2 — Containers: the agents, the pipeline CLI and the sidecar stores.
' Agents write sidecars; the core renders them (docs/rules.md).
' Render: see docs/c4/README.md
!include <C4/C4_Container>

title Rollout — Containers

Person(author, "Product marketer", "Writes the feature description, approves mutations, QA fixes and every publish.")

System_Boundary(rollout, "Rollout") {
  Container(skill, "feature-rollout skill", "Claude Code skill", "Orchestrates one rollout: input → copy → visuals → build → QA → serve; help article and website page on request.")
  Container(copywriter, "rollout-copywriter", "Claude Code agent", "Writes the brief: headline, lead, intro, sections, scene ids, SEO — within the layout limits.")
  Container(designer, "rollout-visual-designer", "Claude Code agent", "Probes the signed-in app, writes capture and kit scenes and social.json, inspects stills, GIFs and web cuts.")
  Container(qa_agent, "rollout-qa", "Claude Code agent, read-only", "Reviews PDF pages and the served web page; returns PASS/FAIL with proposed fixes.")
  Container(helpwriter, "rollout-help-writer", "Claude Code agent", "Finds the help article that covers the feature, writes help.json (new or revised), sends it as a draft after approval.")
  Container(webpublisher, "rollout-web-publisher", "Claude Code agent", "Maps page.json to the site's feature CMS collection or components, writes site.json, builds a draft through the Webflow MCP server after approval.")

  Container(cli, "Pipeline CLI", "Node.js, pipeline/rollout.mjs", "Deterministic core: validate, scene(s), build, social, qa, serve, probe, login, library; help, help-find/get/publish; site, site-find/plan/get/assets/record.")
  Container(kit, "Scene kit", "CSS + seekable JS runtime", "pipeline/kit/: branded HTML scenes for the hero and coming-soon UI, rendered frame-exactly.")
  Container(demo, "Example app", "Node.js HTTP server, demo-app/", "A stand-in product with a real login, for trying the pipeline end to end.")

  ContainerDb(input, "Feature input", "Markdown + JSON, input/{slug}/", "feature.md, feature.json sidecar, optional assets — written by a person.")
  ContainerDb(brand, "Brand sidecars", "JSON + assets, brand/{id}/", "brand.json (colours, fonts, voice, rules, web chrome, help), logos, icons, fonts, integration logos.")
  ContainerDb(config, "Deployment config", ".env, targets/, profiles/", "Which brand, render settings; help center, image store and website connections (tokens); target apps, sign-in, blur/hide; signed-in Chrome profiles (gitignored).")
  ContainerDb(library, "Library", "JSON + HTML + PNG/GIF, library/", "Durable: features/{slug}/ brief.json, social.json, help.json, site.json and the *.published.json records; scenes/{id}/, content-addressed renders/{hash}/, derived index.json.")
  ContainerDb(output, "Build output", "PDF + HTML + JSON, output/{slug}/", "Regenerable: {Feature} One-Pager.pdf, web/ (index.html, page.json, assets), assets/social/, help/, site/ (inventory, assets.json), build.json, qa/.")
}

System_Ext(app, "Product application", "Logged-in SaaS app; captures look, never touch.")
System_Ext(chrome, "Headless Chrome", "puppeteer-core over CDP")
System_Ext(ffmpeg, "ffmpeg", "GIF encoding, frames, help-image frames")
System_Ext(browser, "User's browser", "Previews the served page")
System_Ext(intercom, "Intercom", "Help center: articles, collections, authors (REST API)")
System_Ext(s3, "Amazon S3", "Image store: public help/ prefix for help-article images")
System_Ext(webflow_api, "Webflow Data API", "Sites, pages, components, CMS collections and items, assets (REST)")
System_Ext(webflow_mcp, "Webflow MCP server", "Designer and data tools: CMS items, pages, components, props (Claude connector)")

Rel(author, skill, "'roll out {slug}', 'publish …'", "Claude Code")
Rel(author, input, "Writes")
Rel(skill, copywriter, "Runs")
Rel(skill, designer, "Runs")
Rel(skill, qa_agent, "Runs")
Rel(skill, helpwriter, "Runs (on request)")
Rel(skill, webpublisher, "Runs (on request)")
Rel(skill, cli, "build, social, qa, serve", "shell")

Rel(copywriter, input, "Reads")
Rel(copywriter, brand, "Reads voice and rules", "rollout.mjs brand {slug}")
Rel(copywriter, library, "Writes brief.json")
Rel(designer, library, "Writes scenes/{id}/, social.json")
Rel(designer, cli, "probe, scene {id}, social", "shell")
Rel(qa_agent, cli, "qa {slug}", "shell")
Rel(qa_agent, output, "Reads screenshots and web/")
Rel(helpwriter, library, "Writes help.json")
Rel(helpwriter, cli, "help, help-find, help-get, help-publish", "shell")
Rel(webpublisher, library, "Writes site.json")
Rel(webpublisher, cli, "site-find, site-plan, site-get, site-assets, site-record", "shell")
Rel(webpublisher, webflow_mcp, "Creates draft CMS item, or page and components", "MCP")

Rel(cli, input, "Reads")
Rel(cli, brand, "Reads")
Rel(cli, config, "Reads")
Rel(cli, library, "Reads sidecars; writes renders, index and publish records")
Rel(cli, kit, "Renders kit scenes with")
Rel(cli, output, "Writes PDF, web/, social, help/, site/, build.json, qa/")
Rel(cli, chrome, "Renders, captures, screenshots", "CDP")
Rel(cli, ffmpeg, "Encodes GIFs, frames images", "process")
Rel(cli, app, "Signs in, runs steps, records", "HTTPS + CDP screencast")
Rel(cli, demo, "Same, for the example target", "HTTP")
Rel(cli, s3, "Uploads help images (help-publish)", "S3 API, SigV4")
Rel(cli, intercom, "Finds, reads, creates, updates articles", "HTTPS REST")
Rel(cli, webflow_api, "Reads inventory and items, uploads assets", "HTTPS REST")
Rel(webflow_mcp, webflow_api, "Writes to the same site")
Rel(intercom, s3, "Copies article images", "HTTPS")
Rel(browser, cli, "Loads the page from rollout.mjs serve", "HTTP :WEB_PORT")

SHOW_LEGEND()
@enduml
